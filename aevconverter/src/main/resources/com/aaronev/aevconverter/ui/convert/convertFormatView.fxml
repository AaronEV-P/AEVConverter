<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aaronev.aevconverter.ui.convert.ConvertFormatController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <HBox alignment="CENTER" spacing="8.0" />
                <HBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Label text="Formato de destino:" />
                        <ComboBox fx:id="destinationFormatComboBox" prefWidth="140.0" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="loadButton" mnemonicParsing="false" onAction="#loadFiles" styleClass="button-primary" text="Cargar imágenes" />
                <Button fx:id="clearButton" mnemonicParsing="false" onAction="#clearImages" styleClass="button-secondary" text="Limpiar lista de imágenes" />
            </children>
        </HBox>

        <Label fx:id="statusLabel" styleClass="status-label, status-error" text="Imágenes no cargadas" />

        <ScrollPane fx:id="imageScrollPane"
                    fitToWidth="true"
                    fitToHeight="true"
                    prefHeight="200.0"
                    prefWidth="200.0"
                    styleClass="image-scroll"
                    VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="thumbnailPane"
                          hgap="10.0"
                          styleClass="image-flow-pane"
                          vgap="10.0"/>
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="convertButton" mnemonicParsing="false" onAction="#convertImages" styleClass="button-primary" text="Convertir" />
            </children>
        </HBox>
    </children>
</VBox>
